# Copy this file to .env.local and fill in the values.
#
#   cp .env.example .env.local
#
# .env.local is git-ignored. Values here also need to be set in the Vercel
# project settings for production, followed by a redeploy - Vercel only picks
# up new environment variables on a fresh build.
#
# NOTE: Next.js expands $NAME references when it parses .env files, so a value
# containing "$" can be silently truncated. That is why ADMIN_PASSWORD_HASH
# uses ":" separators instead of "$".

# --- Square: required for the public site -----------------------------------

# Production or sandbox access token, from the Square Developer Portal.
SQUARE_ACCESS_TOKEN=

# "production" or "sandbox".
SQUARE_ENVIRONMENT=production

# The Redmond location ID.
SQUARE_LOCATION_ID=

# Any random string. Guards the /api/revalidate-menu cache-busting endpoint.
# Generate with: openssl rand -hex 16
REVALIDATE_SECRET=

# --- Database: required for the contact form, newsletter, and admin lists ---

# POOLED connection string from the Neon console (the "-pooler" host).
DATABASE_URL=

# --- Admin dashboard: required for /admin -----------------------------------

# Generate with: node scripts/hash-admin-password.mjs 'your-password'
# Note: the script prints the whole "ADMIN_PASSWORD_HASH=..." line.
ADMIN_PASSWORD_HASH=

# At least 32 characters. Generate with: openssl rand -base64 48
SESSION_SECRET=

# --- Optional ---------------------------------------------------------------

# The Square *application* name(s) our checkout orders carry as
# order.source.name. Comma-separated if the app has ever been renamed in the
# Square Developer Portal - keep every past name in the list, since real paid
# orders under an old name will silently vanish from the admin dashboard if
# it's dropped. Defaults (see src/lib/square/config.ts) to both names this
# app has had so far. Get the exact current string from Square (Developer
# Portal, or scripts/verify-square-sources.sh) rather than guessing - it is
# an exact match and whitespace matters.
# SQUARE_PORTAL_SOURCE_NAME=Biryani Catering,BOMMARILLU BIRYANI  425-420-0160

# Days of Square order history the admin dashboard scans. Default 365, max 365.
# ADMIN_ORDER_LOOKBACK_DAYS=365
